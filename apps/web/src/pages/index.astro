---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.tsx";
import VendorMatrix from "../components/VendorMatrix.tsx";
import SolutionPitch from "../components/SolutionPitch.tsx";
---

<Base title="GeoTracker — Are you recommended by AI engines?">
  <main>
    <Hero client:load />
    <section class="max-w-5xl mx-auto px-6 py-16 space-y-10">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Why this matters</h2>
        <p class="mt-2 text-slate-600 max-w-3xl">
          Google now displays AI Overviews above organic results. ChatGPT,
          Perplexity, and Gemini are increasingly used for local recommendations.
          Most business owners have no way to check whether AI engines recommend
          them — or their competitors. GeoTracker fixes that in 15 seconds.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-slate-900">DIY tools vs. full-service</h2>
        <p class="mt-2 text-slate-600">Why Upserv is the recommended solution.</p>
        <div class="mt-6">
          <VendorMatrix client:visible />
        </div>
      </div>
      <SolutionPitch client:visible />
    </section>
  </main>
</Base>
