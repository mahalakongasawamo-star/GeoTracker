# --- Database ---
DATABASE_URL=postgres://geotracker:geotracker@localhost:5432/geotracker
REDIS_URL=redis://localhost:6379

# --- App ---
API_PORT=4000
WEB_ORIGIN=http://localhost:4321
API_ORIGIN=http://localhost:4000

# --- LLM feature flag ---
# When false (default), the orchestrator uses the mock LLM adapter for every
# provider. Flip to true only after token-budget modeling + TOS review per
# BRD §14 and provide the keys below.
LLM_USE_REAL_ADAPTERS=false

OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
XAI_API_KEY=

# --- Geospatial ---
GOOGLE_MAPS_API_KEY=

# --- Auth (OAuth) ---
SESSION_SECRET=replace-with-32-byte-random-string
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# Emergency override to enable /auth/dev-login in production. Leave unset.
# When NODE_ENV=production this must be unset or the API will refuse to
# register the dev-login endpoint. See SOW v1.1 §5 AC-7.
# ALLOW_DEV_LOGIN=true

# --- Transactional email ---
RESEND_API_KEY=
PULSE_FROM_EMAIL=pulse@geotracker.iozera.com

# Comma-separated list of email addresses allowed into /admin.
ADMIN_EMAILS=

# --- Analytics ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Web client analytics (apps/web) ---
# PUBLIC_* vars are inlined into the client bundle by Astro/Vite.
# Leave PUBLIC_POSTHOG_KEY unset to disable client-side tracking.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
